# Server configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database:
# For SQLite (zero setup, works immediately):
DATABASE_URL=sqlite+aiosqlite:///./qaqpan.db
# For PostgreSQL (just uncomment when PostgreSQL/Docker is available):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qaqpan_db

# CORS origins (for Frontend Vite dev server)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# LLM Configuration (Backend 2 will use this)
GEMINI_API_KEY=
OPENAI_API_KEY=


# Demo tuning (optional). The idea suggests 900 (15 min) for the trusted person's answer.
# TRUSTED_TIMEOUT_SECONDS=30
# CLIENT_TYPICAL_AMOUNT=50000
# ANSWER_TIMEOUT_SECONDS=300
# TYPICAL_AMOUNT_MIN_SAMPLES=3
# TYPICAL_AMOUNT_HISTORY_LIMIT=20
